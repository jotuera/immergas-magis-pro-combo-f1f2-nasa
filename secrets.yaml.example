# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is git-ignored and must NEVER be committed.

wifi_ssid: "Your WiFi SSID"
wifi_password: "Your WiFi password"

# ESPHome native API encryption key (32 random bytes, base64) - generate one at
# https://esphome.io/components/api.html#configuration-variables
api_encryption_key: "REPLACE_WITH_YOUR_BASE64_KEY="
ota_password: "change-me"
